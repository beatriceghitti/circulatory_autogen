# Compiler: MPI C++ wrapper. It must belong to the same MPI installation as the 0d solver
# (main0d), the mpi4py used by the 1d solver, and the mpirun used to launch the coupled run.
CXX = mpic++
# Compiler flags (add -g for debug, or -O2/-O3 for optimization, or -Wall for enabling warning messages)
CXXFLAGS = -Wall -O2 -std=c++17 $(INC_DIR)
# CXXFLAGS = $(INC_DIR)
# Skip the deprecated MPI C++ bindings (we use the C API; avoids header warnings)
CPPFLAGS = -DOMPI_SKIP_MPICXX -DMPICH_SKIP_MPICXX

# nlohmann-json paths from Spack
JSON_PREFIX := $(shell spack location -i nlohmann-json)
INC_DIR = -I$(JSON_PREFIX)/include
# LIB_DIR = -L$(JSON_PREFIX)/lib

# Source files
SRCS = coupler.cpp coupler_auxFun.cpp
# Object files (auto-generated from SRCS)
OBJS := $(SRCS:.cpp=.o) # OBJS = $(SRCS:.cpp=.o)
# Target binary/executable
TARGET = coupler

all: $(TARGET)

# Link target
$(TARGET): $(OBJS)
	$(CXX) $(CXXFLAGS) -o $@ $(OBJS)

# Header dependencies: when compiling, the compiler also writes a .d file next to each object file (-MMD), listing
# the headers it includes (coupler_mpi_common.h, coupler_auxFun.h), so that make recompiles the object file when one of
# them changes, e.g. after regenerating the model, without 'make clean'. -MP: a header that no longer exists does not
# stop make. An object file without its .d file (e.g. built before) is recompiled once.
DEPFLAGS = -MMD -MP
DEPS := $(OBJS:.o=.d)

# Compile source files
%.o: %.cpp %.d
	$(CXX) $(CPPFLAGS) $(CXXFLAGS) $(DEPFLAGS) -c $< -o $@

# .d files: written by the compiler (no rule to make them), and read only if they exist
$(DEPS):
include $(wildcard $(DEPS))

# Clean
clean:
	rm -f $(OBJS) $(DEPS) $(TARGET)

.PHONY: all clean
