# PETSc configuration
# Adjust PETSC_DIR and PETSC_ARCH as needed

# THE LINE BELOW MUST BE CHANGED
PETSC_DIR=/home/bghi639/petsc-install
# The line below is for Docker container environment
# PETSC_DIR=/opt/petsc-install

PETSC_ARCH=
# PETSC_ARCH=""
# PETSC_ARCH = arch-linux-c-opt

# Verify that the directory actually exists
ifeq ($(wildcard $(PETSC_DIR)),)
  $(error PETSC_DIR=$(PETSC_DIR) does not exist)
endif

ifeq ($(wildcard $(PETSC_DIR)/include/petsc.h),)
  $(error PETSC_DIR=$(PETSC_DIR) does not contain petsc.h)
endif

include $(PETSC_DIR)/lib/petsc/conf/variables

# General compiler settings
CXX      := mpicxx # PETSc is built with MPI
CXXFLAGS := -std=c++17 -Wall -Wextra
CXXFLAGS += -I$(PETSC_DIR)/include
CXXFLAGS += -Iinclude
LDFLAGS  += $(PETSC_LIB)

# Debug / Release
ifeq ($(DEBUG),1)
  CXXFLAGS += -O0 -g -DDEBUG
else
  CXXFLAGS += -O3 -DNDEBUG
endif
TARGET   := model0d

# Source / include layout
SRCDIR   := .
SRC_CC   := $(wildcard $(SRCDIR)/*.cc)
SRC_CPP  := $(wildcard $(SRCDIR)/*.cpp)
SRC      := $(SRC_CC) $(SRC_CPP)

OBJ      := $(SRC:.cc=.o)
OBJ      := $(OBJ:.cpp=.o)

# Build rules
.PHONY: all clean

all: $(TARGET)

$(TARGET): $(OBJ)
	$(CXX) $(CXXFLAGS) -o $@ $^ $(LDFLAGS)

# Header dependencies: when compiling, the compiler also writes a .d file next to each object file (-MMD), listing
# the headers it includes (the model header), so that make recompiles the object file when one of
# them changes, e.g. after regenerating the model, without 'make clean'. -MP: a header that no longer exists does not
# stop make. An object file without its .d file (e.g. built before) is recompiled once.
DEPFLAGS = -MMD -MP
DEPS := $(OBJ:.o=.d)

%.o: %.cc %.d
	$(CXX) $(CXXFLAGS) $(DEPFLAGS) -c $< -o $@
%.o: %.cpp %.d
	$(CXX) $(CXXFLAGS) $(DEPFLAGS) -c $< -o $@

# .d files: written by the compiler (no rule to make them), and read only if they exist
$(DEPS):
include $(wildcard $(DEPS))

clean:
	$(RM) $(OBJ) $(DEPS) $(TARGET)
